[Unit]
Description=WaterfallHunter canonical SIGNAL_ONLY stack
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/srv/waterfallhunter/app
Environment=WFH_ENV_FILE=/etc/waterfallhunter/waterfallhunter.env
ExecStart=/usr/bin/docker compose --project-name waterfallhunter --env-file /etc/waterfallhunter/waterfallhunter.env -f /srv/waterfallhunter/app/docker-compose.yml up -d --remove-orphans
ExecStop=/usr/bin/docker compose --project-name waterfallhunter --env-file /etc/waterfallhunter/waterfallhunter.env -f /srv/waterfallhunter/app/docker-compose.yml stop --timeout 30
TimeoutStartSec=180
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
